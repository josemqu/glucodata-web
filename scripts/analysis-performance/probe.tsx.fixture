'use client';
import { useEffect, useState } from 'react';
import { benchmarkReset, benchmarkFailure } from '@/app/actions';
export function BenchmarkProbe() {
  const [failure, setFailure] = useState(false);
  const [samples, setSamples] = useState<string[]>([]);
  useEffect(() => {
    let frame = 0;
    const click = (event: MouseEvent) => {
      const button = (event.target as Element).closest('button');
      if (!button || button.closest('[data-benchmark-probe]')) return;
      const label = button.textContent?.trim() || button.getAttribute('aria-label') || '';
      if (!/^(7 d|14 d|30 d|90 d|Perfil|Año|Análisis|Monitor)$/i.test(label) && !/año/i.test(label)) return;
      cancelAnimationFrame(frame);
      const start = performance.now(); let stable = 0; let previous = '';
      const tick = () => {
        const line = document.querySelector('.recharts-line-curve');
        const calendar = document.querySelector('button[aria-label$="Abrir en Monitor."]');
        const loading = document.querySelector('.animate-spin');
        const surface = line?.closest('svg') || calendar?.closest('[aria-label^=\"Calendario\"]');
        const rect = surface?.getBoundingClientRect();
        const clips = line?.closest('svg')?.querySelectorAll('clipPath');
        const clipShape = clips ? Array.from(clips).map(clip => clip.innerHTML).join('') : '';
        const shape = clipShape + (line?.getAttribute('d') || calendar?.getAttribute('aria-label') || '') + (rect ? `:${rect.width}:${rect.height}` : '');
        stable = shape && shape === previous && !loading ? stable + 1 : 0;
        previous = shape;
        if (stable >= 3) { setSamples(values => [...values, `${label}: ${Math.round(performance.now() - start)} ms`]); return; }
        if (performance.now() - start < 20000) frame = requestAnimationFrame(tick);
      };
      frame = requestAnimationFrame(tick);
    };
    document.addEventListener('click', click, true);
    return () => { document.removeEventListener('click', click, true); cancelAnimationFrame(frame); };
  }, []);
  return <details data-benchmark-probe style={{ position: 'fixed', bottom: 0, right: 0, zIndex: 200, background: '#101820', color: 'white', padding: 6, fontSize: 11 }} open>
    <summary>Benchmark sintético · 40 ms/página</summary>
    <button onClick={async () => { await benchmarkReset(); setSamples([]); }}>Vaciar caché del servidor</button>
    <button onClick={async () => { await benchmarkFailure(!failure); setFailure(!failure); }}>{failure ? "Desactivar error simulado" : "Simular error"}</button>
    <pre data-testid="benchmark-samples">{samples.join('\n')}</pre>
  </details>;
}
